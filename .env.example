# Copy this file to .env and fill in real values.

# MySQL connection string used by Drizzle ORM (lib/db/index.ts, drizzle.config.ts)
DATABASE_URL="mysql://user:password@127.0.0.1:3306/tuger_db?charset=utf8mb4"

# Secret used to sign session/captcha JWTs (lib/auth.ts, lib/captcha.ts).
# Required in production — the app throws on startup if missing.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Meilisearch instance used for product search (lib/meilisearch.ts, scripts/sync-meilisearch.ts)
MEILISEARCH_HOST="http://127.0.0.1:7700"
MEILISEARCH_API_KEY=

# Public Sentry DSN for error monitoring (sentry.*.config.ts). Optional — falls back to a
# disabled placeholder DSN if unset.
NEXT_PUBLIC_SENTRY_DSN=

# Public base URL of the deployed site, used for metadata/OG tags, sitemap.xml,
# and robots.txt (app/(public)/layout.tsx, app/sitemap.ts, app/robots.ts).
NEXT_PUBLIC_SITE_URL="https://pixeon.com.tr"

# SMTP for transactional emails (lib/email.ts): order confirmations, support
# ticket replies. Optional — emails are silently skipped (with a console
# warning) if these aren't set, so leaving them blank never breaks checkout.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PIXEON <destek@pixeon.com.tr>"

# PayTR payment gateway (lib/paytr.ts). NOT wired into checkout yet — the
# library is built against PayTR's documented iFrame API but was never tested
# against a real merchant account. See the comment at the bottom of
# lib/paytr.ts for what's left to connect it to /odeme.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

# NetGSM SMS (lib/netgsm.ts) — sends a "your order shipped" SMS. Optional,
# same graceful-skip-if-unset behavior as SMTP above.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# Google OAuth login (lib/google-oauth.ts, app/api/auth/google/*). Optional —
# the "Google Hesabı" button on /login redirects to /login?error=... if
# these aren't set, rather than erroring. Create credentials at
# https://console.cloud.google.com/apis/credentials — set the authorized
# redirect URI to {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
